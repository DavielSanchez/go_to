{
  "name": "rutas-go-mvp",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite frontend",
    "dev:api": "node --watch backend/index.js",
    "dev:all": "concurrently -n WEB,API -c green,cyan \"npm:dev\" \"npm:dev:api\"",
    "build": "vite build frontend --configLoader runner",
    "preview": "vite preview frontend",
    "start": "node backend/index.js",
    "seed": "node backend/seed.js && node backend/seed-cases.js",
    "test:api": "node --test backend/tests/*.test.js"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "fflate": "^0.8.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "morgan": "^1.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-qr-code": "^2.0.15",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.1",
    "vite": "^6.3.5"
  },
  "packageManager": "npm@10.9.2",
  "engines": { "node": ">=20" }
}
